# === VIPER Forensic Engine .gitignore ===

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*~

# Agent instructions, plans, and outlines (local working notes)
.claude/

# Jupyter
.ipynb_checkpoints/

# Environment secrets
.env

# Data — large, download separately
data/cifake/
data/wikiart/
data/Art/
data/ai_art_classification/

# Model weights are published as GitHub Release assets, not committed:
# every checkpoint exceeds GitHub's hard 100 MB per-file limit.
# checkpoints/SHA256SUMS and checkpoints/MODEL_CARD.md are tracked instead.
*.pth
*.pt
checkpoints/torchvision_weights/

# Results ARE published: metrics, per-sample scores and charts are the
# evidence behind every number in the README, so they are tracked on purpose.
# Only the reproducible-but-bulky UMAP coordinate dump stays out.
results/umap_features.csv
gradcam_gallery/*.png
gradcam_gallery/*.jpg

# Training logs are tracked (raw evidence for the metrics); pod plumbing
# logs are not.
results/**/chain*.log
results/**/canon*.log
results/**/setup.log
results/run_full.log

# OS
.DS_Store
Thumbs.db
desktop.ini
